
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read access to feedback, but only allow creation.
    // This allows anyone to submit feedback. For a more secure setup,
    // you would require authentication (e.g., allow create: if request.auth != null;).
    match /student-feedback/{feedbackId} {
      allow read: if true;
      allow list: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }
  }
}
