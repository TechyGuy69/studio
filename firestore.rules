
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read and list access to feedback, but only allow creation.
    // This allows anyone to submit and view feedback. For a more secure setup,
    // you might require authentication for creating feedback.
    match /student-feedback/{feedbackId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }
  }
}
