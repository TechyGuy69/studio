{
  "entities": {
    "Feedback": {
      "title": "Feedback",
      "type": "object",
      "description": "Represents feedback given by a student for a course.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the person leaving feedback."
        },
        "class": {
          "type": "string",
          "description": "The class/grade of the student leaving feedback."
        },
        "quote": {
          "type": "string",
          "description": "The feedback message or quote."
        },
        "rating": {
          "type": "number",
          "description": "A rating from 1 to 5."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the feedback was submitted."
        }
      },
      "required": ["name", "class", "quote", "rating", "createdAt"]
    }
  },
  "auth": {
    "providers": [
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/feedbacks/{feedbackId}",
        "definition": {
          "entityName": "Feedback",
          "schema": {
            "$ref": "#/backend/entities/Feedback"
          },
          "description": "Stores all student feedback entries.",
          "params": [
            {
              "name": "feedbackId",
              "description": "The unique identifier of the feedback entry."
            }
          ]
        }
      }
    ]
  }
}
